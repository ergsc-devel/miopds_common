<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://pds.nasa.gov/pds4/pds/v1/PDS4_PDS_1M00.sch" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<Product_Collection
    xmlns="http://pds.nasa.gov/pds4/pds/v1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pds.nasa.gov/pds4/pds/v1 https://pds.nasa.gov/pds4/pds/v1/PDS4_PDS_1M00.xsd">

  <Identification_Area>
    <logical_identifier>{{ lid }}</logical_identifier>
    <version_id>{{ version_id | default('1.0') }}</version_id>
    <title>PWI {{ collection_name | default('Data') }} Collection</title>
    <information_model_version>1.22.0.0</information_model_version>
    <product_class>Product_Collection</product_class>

    <Citation_Information>
      <publication_year>{{ publication_year | default('2027') }}</publication_year>
      <description>
        This collection contains BepiColombo Mio Plasma Wave Investigation
        products for {{ collection_name | default('the specified data collection') }}.
      </description>
    </Citation_Information>
  </Identification_Area>

  <Collection>
    <collection_type>Data</collection_type>
    <description>
      This collection contains BepiColombo Mio Plasma Wave Investigation
      products for {{ collection_name | default('the specified data collection') }}.
    </description>
  </Collection>

  <File_Area_Inventory>
    <File>
      <file_name>{{ csv }}</file_name>
      <file_size unit="byte">{{ size }}</file_size>
      <md5_checksum>{{ md5 }}</md5_checksum>
    </File>

    <Inventory>
      <offset unit="byte">0</offset>
      <object_length unit="byte">{{ size }}</object_length>
      <parsing_standard_id>PDS DSV 1</parsing_standard_id>
      <records>{{ records }}</records>
      <record_delimiter>Carriage-Return Line-Feed</record_delimiter>
      <field_delimiter>Comma</field_delimiter>

      <Record_Delimited>
        <fields>2</fields>
        <groups>0</groups>

        <Field_Delimited>
          <name>Member Status</name>
          <field_number>1</field_number>
          <data_type>ASCII_String</data_type>
          <maximum_field_length unit="byte">1</maximum_field_length>
          <description>
            P identifies a primary member and S identifies a secondary member.
          </description>
        </Field_Delimited>

        <Field_Delimited>
          <name>LIDVID_LID</name>
          <field_number>2</field_number>
          <data_type>ASCII_LIDVID_LID</data_type>
          <maximum_field_length unit="byte">255</maximum_field_length>
          <description>
            The logical identifier, optionally followed by the version
            identifier, of a Collection member product.
          </description>
        </Field_Delimited>
      </Record_Delimited>

      <reference_type>inventory_has_member_product</reference_type>
    </Inventory>
  </File_Area_Inventory>
</Product_Collection>
